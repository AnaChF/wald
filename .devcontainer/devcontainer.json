{
  "name": "Wald Ecosystem",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "forwardPorts": [3001, 5173, 5174, 5175],
  "portsAttributes": {
    "3001": { "label": "API", "onAutoForward": "notify" },
    "5173": { "label": "Walditorium", "onAutoForward": "openBrowser" },
    "5174": { "label": "Harvest Trees", "onAutoForward": "notify" },
    "5175": { "label": "Community", "onAutoForward": "notify" }
  },
  "postCreateCommand": "npm install",
  "postStartCommand": "npm run dev:api &",
  "customizations": {
    "vscode": {
      "extensions": ["esbenp.prettier-vscode", "dbaeumer.vscode-eslint"],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  }
}
