{
  "name": "wald",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "npm run dev -w packages/api",
    "dev:api": "npm run dev -w packages/api",
    "dev:walditorium": "npm run dev -w apps/walditorium",
    "dev:harvest-trees": "npm run dev -w apps/harvest-trees",
    "dev:community": "npm run dev -w apps/community",
    "dev:canopy": "npm run dev -w apps/canopy",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "@types/node": "^20.12.0"
  }
}
